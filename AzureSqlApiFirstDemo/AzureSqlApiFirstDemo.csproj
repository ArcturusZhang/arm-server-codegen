<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <TypeSpecProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\typespec'))</TypeSpecProjectDir>
    <GeneratedCodeDir>$(MSBuildProjectDirectory)\Generated</GeneratedCodeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
  </ItemGroup>

  <Target Name="GenerateServerCode_V20251101" BeforeTargets="BeforeBuild">
    <Message Text="Generating server code for version 2025-11-01..." Importance="high" />
    <Exec Command="npx tsp compile . --emit @azure-tools/typespec-server-emitter --option @azure-tools/typespec-server-emitter.version=2025-11-01 --option @azure-tools/typespec-server-emitter.emitter-output-dir=$(GeneratedCodeDir)\V20251101"
          WorkingDirectory="$(TypeSpecProjectDir)" />
  </Target>

  <Target Name="GenerateServerCode_V20251201" BeforeTargets="BeforeBuild">
    <Message Text="Generating server code for version 2025-12-01..." Importance="high" />
    <Exec Command="npx tsp compile . --emit @azure-tools/typespec-server-emitter --option @azure-tools/typespec-server-emitter.version=2025-12-01 --option @azure-tools/typespec-server-emitter.emitter-output-dir=$(GeneratedCodeDir)\V20251201"
          WorkingDirectory="$(TypeSpecProjectDir)" />
  </Target>

  <Target Name="GenerateServerCode_V20260201" BeforeTargets="BeforeBuild">
    <Message Text="Generating server code for version 2026-02-01..." Importance="high" />
    <Exec Command="npx tsp compile . --emit @azure-tools/typespec-server-emitter --option @azure-tools/typespec-server-emitter.version=2026-02-01 --option @azure-tools/typespec-server-emitter.emitter-output-dir=$(GeneratedCodeDir)\V20260201"
          WorkingDirectory="$(TypeSpecProjectDir)" />
  </Target>

</Project>

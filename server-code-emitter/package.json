{
  "name": "@azure-tools/typespec-server-emitter",
  "version": "0.1.0",
  "description": "TypeSpec emitter that generates ASP.NET Core server code for Azure SQL-style versioned APIs",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf ./dist ./temp",
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@alloy-js/core": "^0.22.0",
    "@azure-tools/typespec-azure-core": "^0.64.0",
    "@azure-tools/typespec-azure-resource-manager": "^0.64.1",
    "@typespec/compiler": ">=1.0.0",
    "@typespec/emitter-framework": "^0.15.0",
    "@typespec/http": "^1.8.0",
    "@typespec/rest": "^0.78.0",
    "@typespec/versioning": "^0.78.0"
  },
  "devDependencies": {
    "@alloy-js/core": "^0.22.0",
    "@alloy-js/csharp": "^0.22.0",
    "@azure-tools/typespec-azure-core": "^0.64.0",
    "@azure-tools/typespec-azure-resource-manager": "^0.64.1",
    "@typespec/compiler": "^1.8.0",
    "@typespec/emitter-framework": "^0.15.0",
    "@typespec/http": "^1.8.0",
    "@typespec/rest": "^0.78.0",
    "@typespec/versioning": "^0.78.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0"
  }
}
